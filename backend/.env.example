# MargDarshak Environment Configuration Template

# Database Connection (Default is zero-dependency SQLite; replace with PostgreSQL/PostGIS for production)
DATABASE_URL=sqlite:///./margdarshak.db
# DATABASE_URL=postgresql://margdarshak:margdarshak123@localhost:5432/margdarshak_db

# Security & JWT
JWT_SECRET=margdarshak_super_secret_jwt_key_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Environment Mode
ENVIRONMENT=development
DEBUG=True

# Optional External APIs (System automatically falls back to deterministic mocks when empty)
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b-conversations
WEATHER_API_KEY=
ROUTING_API_URL=
REDIS_URL=

# Solver Configuration
SOLVER_TIME_LIMIT_SECONDS=15
